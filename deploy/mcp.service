[Unit]
Description=Sergiu-AI MCP Server
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/opt/mcp
# The API key is fetched from AWS Secrets Manager via the instance role.
# MCP_SECRET_NAME activates that path; without it the app would fall back to
# the dev-local-key default. (MCP_API_KEY is only the local/dev fallback.)
Environment=MCP_SECRET_NAME=mcp/api-key
Environment=MCP_SECRET_REGION=us-east-1

# App logging: systemd creates /var/log/mcp owned by this service user, and
# LOGGING_FILE_NAME tells Spring Boot to write there (ECS JSON, per
# application.yaml). The app still logs plain text to the console/journald too.
LogsDirectory=mcp
Environment=LOGGING_FILE_NAME=/var/log/mcp/app.log

ExecStart=/usr/bin/java -jar /opt/mcp/app.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
